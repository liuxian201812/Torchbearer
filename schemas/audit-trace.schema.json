{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "window_id",
    "termination_requested",
    "baseline_evidence_ids",
    "focus",
    "steps",
    "previous_steps",
    "candidates",
    "actions",
    "evidence",
    "assessments"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "window_id": {
      "$ref": "#/$defs/id"
    },
    "termination_requested": {
      "type": "boolean"
    },
    "baseline_evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "focus": {
      "type": "object",
      "required": [
        "reason",
        "supporting_evidence_ids"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "previous_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "candidate_id",
        "method_family",
        "new_evidence_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "method_family": {
          "$ref": "#/$defs/id"
        },
        "new_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "description",
        "method_family"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method_family": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "candidate_id",
        "feasible",
        "status",
        "basis",
        "source_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "candidate_id": {
          "$ref": "#/$defs/id"
        },
        "feasible": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "running",
            "completed",
            "blocked",
            "ruled_out",
            "deferred"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "basis",
        "source_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "id",
        "source_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "goal_narrowed": {
          "type": "boolean"
        },
        "limitation_identified": {
          "type": "boolean"
        },
        "feasible_followup": {
          "type": "boolean"
        },
        "supporting_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "followup_action_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
